# 开发环境配置
# Development Environment Configuration

# API 基础地址
# 必须留空！留空后请求为相对路径 /api/xxx，由 vite.config.ts 的 server.proxy 转发到后端，
# 不存在跳域问题（转发在 Node 端完成），与生产环境 Nginx 同源代理行为一致。
# 切换后端地址请修改 vite.config.ts 中的 proxy.target，不要在此处填绝对地址。
# （填绝对地址会绕过代理直连后端，通过 IP 访问开发服务时会被 CORS 拦截）
VITE_API_BASE_URL=
# VITE_API_BASE_URL=http://47.101.161.124
    
# 应用标题
VITE_APP_TITLE=TradingAgents-CN

# 微信公众号 AppID（用于微信授权登录）
VITE_WECHAT_APP_ID=wx183521434338da29

# 开发模式
NODE_ENV=development
